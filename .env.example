# Mailmap environment variables
# Copy this file to `.env.local` and fill in your own values.
# These are OAuth *client IDs*: public identifiers that end up in the browser bundle.
# They are NOT secrets. Never put a client secret in any VITE_ variable — Vite
# embeds every VITE_ variable into the JavaScript that is sent to users.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra admin center → App registrations → Application (client) ID
# Platform: Single-page application
VITE_MICROSOFT_CLIENT_ID=

# Optional. "common" allows both work/school and personal Microsoft accounts.
VITE_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# Optional. Mail.Read (default) or Mail.ReadBasic. See docs/PROVIDER_SETUP.md before changing.
VITE_MICROSOFT_MAIL_SCOPE=Mail.Read
